# ==========================================
# GitHub Integration Configuration
# ==========================================

# Optional server-only GitHub Personal Access Token (classic or fine-grained)
# If provided, the application uses GitHub GraphQL API to retrieve pinned items.
# If omitted, the application uses GitHub REST API with verified fallback caching.
# NEVER prefix with NEXT_PUBLIC_
GITHUB_TOKEN=your_github_token_here

# ==========================================
# Deployment Configuration
# ==========================================

# Production domain used for canonical SEO links and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://taufik-portfolio.vercel.app
